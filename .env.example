# ─────────────────────────────────────────────────────────────────────────────
# Musicosy — environment variable template
# Copy to `.env.local` and fill with real values. NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Existing: Prisma / SQLite (Help Center file-based CMS) ───────────────────
# Kept as the legacy data source during the Payload + Supabase migration.
# Will be removed once parity is verified and the frontend switches to Payload.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ── Supabase project ────────────────────────────────────────────────────────
# Used by: Supabase CLI, future Payload Postgres adapter, migration scripts.
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_PROJECT_REF=""                # e.g. "abcdefghijklmnop"
SUPABASE_DB_URL=""                    # postgres connection string, e.g. postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=""                       # https://[ref].supabase.co
SUPABASE_ANON_KEY=""                  # public anon key (RLS-enforced)
SUPABASE_SERVICE_ROLE_KEY=""          # SECRET — service role key, bypasses RLS. Never expose to client.

# ── Payload CMS (forthcoming — install in next step) ───────────────────────
# Payload 3.x runs in-process inside Next.js. Reads Supabase Postgres via
# @payloadcms/db-postgres or sqlite adapter during parity tests.
PAYLOAD_SECRET=""                     # random 32+ char string, used to sign JWTs
PAYLOAD_PUBLIC_URL="http://localhost:3000"  # base URL for admin UI / preview links

# ── Migration script (transient — used only during cutover) ─────────────────
# Toggle to switch the [...path] route between legacy TS docs and Payload.
DATA_SOURCE="ts"                      # "ts" (legacy) | "payload" (post-migration)
