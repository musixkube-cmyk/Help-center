# ─────────────────────────────────────────────────────────────────────────────
# Musicosy — environment variable template
# Copy to `.env.local` and fill with real values. NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────
# Precedence (Next.js): .env.local > .env.{NODE_ENV}.local > .env.{NODE_ENV}
# > .env. .env.local is loaded in ALL environments and overrides everything else.
# ─────────────────────────────────────────────────────────────────────────────

# ── Payload CMS — Postgres (PRIMARY data source for /cms) ────────────────────
# Read FIRST by src/payload.config.ts. Must be a session-mode pooler (port 5432)
# because Payload migrations issue DDL — transaction-mode poolers (port 6543
# with pgbouncer=true) drop prepared statements on DDL and break migrations.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
PAYLOAD_DATABASE_URL=""

# Payload auth secret — random 32+ char string, signs JWTs. Generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=""

# Public URL of the running Next.js server. Payload uses this for admin links,
# live preview, and CSRF checks. Local dev = http://localhost:3000
PAYLOAD_PUBLIC_URL="http://localhost:3000"

# ── Supabase (client SDK + service role) ─────────────────────────────────────
# Used by frontend Supabase client + any server-side service-role calls.
NEXT_PUBLIC_SUPABASE_URL=""             # https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=""       # public anon key (RLS-enforced)
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=""# SECRET — bypasses RLS. Never expose to client.

# ── Legacy: Prisma / SQLite ──────────────────────────────────────────────────
# Used ONLY by Prisma for the legacy Help Center file-based CMS during the
# Payload migration parity test. Will be removed once DATA_SOURCE=payload is
# green and the frontend switches fully to Payload.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ── Migration toggle (transient — used only during cutover) ──────────────────
# Switches the [...path] catch-all route between legacy TS docs and Payload.
DATA_SOURCE="ts"                        # "ts" (legacy) | "payload" (post-migration)
